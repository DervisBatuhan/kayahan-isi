# Local: a SQLite file. Production (Vercel): a Turso libSQL URL —
#   DATABASE_URL="libsql://<db>-<org>.turso.io"
#   DATABASE_AUTH_TOKEN="<turso db token>"
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

AUTH_SECRET="generate-with: openssl rand -base64 32"

# Vercel Blob — stores certificate files uploaded from the admin panel.
# Auto-added to the project env once a Blob store is attached in the Vercel
# dashboard (Storage → Create → Blob). Without it, certificate uploads fail
# gracefully and the rest of the site is unaffected.
BLOB_READ_WRITE_TOKEN=""

# Canonical origin used for metadata, canonicals, hreflang, sitemap and JSON-LD.
# Defaults to https://www.kayahanisi.com.tr when unset; override on preview/staging.
NEXT_PUBLIC_SITE_URL="https://www.kayahanisi.com.tr"

ADMIN_EMAIL="admin@kayahanisi.com.tr"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Kayahan Yönetici"

# --- SEO / analytics (all optional; leave blank to disable) ---
# Google Search Console HTML-tag verification (or verify via DNS instead)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools meta verification
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=""

# --- Cloudflare Turnstile (bot protection on the contact + quote forms) ---
# Both optional: when either is blank the forms still work and verification is
# skipped. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
