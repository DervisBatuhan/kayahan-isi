// Kayahan Isı — admin panel data model.
// Local: SQLite (file:./dev.db). Production (Vercel): Turso / libSQL via the
// @prisma/adapter-libsql driver adapter — swap the datasource url + adapter then.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  // "native" for local dev; the rhel target is what Vercel's Node runtime needs.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("editor") // "admin" | "editor"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One row per locale. `data` is the full structured SiteContent JSON
/// (validated with Zod on write). Keeps the panel flexible while the public
/// site keeps its typed shape.
model SiteContent {
  id        String   @id @default(cuid())
  locale    String   @unique // "tr" | "en"
  data      String   // JSON string
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Page {
  id        String   @id @default(cuid())
  locale    String
  slug      String // e.g. "kurumsal/hakkimizda"
  eyebrow   String
  title     String
  intro     String
  bullets   String   @default("[]") // JSON string[]
  children  String   @default("[]") // JSON {title,slug,text}[]
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
}

/// Structured content for the richly-designed inner pages ("ported" layouts).
/// One row per page (family + kind + locale). `data` is the full editable
/// content tree as JSON, validated on write; the static default in
/// `lib/content/ported/*` is the fallback when a row is missing.
model PortedContent {
  id        String   @id @default(cuid())
  family    String // "hub" | "corporate" | "activity" | "solution" | "expansion" | "utility"
  kind      String // e.g. "about", "heating", "systems"
  locale    String   @default("tr")
  data      String // JSON string
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([family, kind, locale])
}

/// A blog post. Each row is one locale; a TR post and its EN translation share
/// a `pairKey` so the article pages can cross-link with hreflang. `content` is
/// Markdown (rendered by `lib/blog/markdown.ts`, never raw HTML). `publishedAt`
/// is the editorial date shown on the page and in `datePublished`.
model BlogPost {
  id          String    @id @default(cuid())
  locale      String    @default("tr")
  slug        String // URL segment after /<locale>/blog/
  title       String
  excerpt     String    @default("") // list card + meta description
  content     String    @default("") // Markdown
  coverUrl    String    @default("") // Vercel Blob public URL or ""
  coverAlt    String    @default("")
  tags        String    @default("[]") // JSON string[]
  pairKey     String? // shared between a post and its translation
  published   Boolean   @default(false)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedBy   String?

  @@unique([locale, slug])
  @@index([locale, published, publishedAt])
}

/// One row per admin login attempt. Used to throttle brute-force guessing:
/// too many failures from the same IP inside the window locks that IP out for
/// a while. Rows are pruned opportunistically on write.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String   @default("")
  ok        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model Lead {
  id          String   @id @default(cuid())
  type        String   @default("contact") // "contact" | "quote"
  name        String
  phone       String
  email       String?
  company     String?
  subject     String   @default("") // contact form: selected subject
  projectType String   @default("") // quote form: project type
  location    String   @default("") // quote form: city / district
  fields      String   @default("[]") // quote form: interested areas (JSON string[])
  message     String   @default("")
  source      String   @default("") // which page / form
  locale      String   @default("tr")
  status      String   @default("new") // "new" | "contacted" | "closed"
  notes       String   @default("") // internal admin notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
